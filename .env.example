# Copy to .env and fill in your key(s) (this file is read by run_daily.sh)

# OpenRouter API key — powers the free NVIDIA Nemotron primary provider.
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# Gemini API key — used as the final fallback. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-2.5-pro-api-key-here

# Optional: LinkedIn credentials (or fill them in config.yaml)
# LINKEDIN_EMAIL=you@example.com
# LINKEDIN_PASSWORD=your-password
